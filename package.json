{
  "name": "sketchspace",
  "version": "0.2.0",
  "description": "A focused desktop wireframe editor for Windows and macOS",
  "author": "will-krof",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "node scripts/build-site.cjs",
    "desktop:dev": "electron .",
    "desktop:pack": "electron-builder --win dir --publish never",
    "desktop:dist": "electron-builder --win nsis --publish never",
    "desktop:release": "electron-builder --win nsis --publish always",
    "desktop:mac:pack": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --universal --publish never -c.mac.notarize=false -c.mac.identity=- -c.mac.hardenedRuntime=false -c.directories.output=\"${TMPDIR:-/private/tmp}/sketchspace-local-release\"",
    "desktop:mac:dist": "electron-builder --mac dmg zip --universal --publish never",
    "test": "node --test tests/*.test.*",
    "bench:storage": "node scripts/benchmark-storage.cjs",
    "db:generate": "drizzle-kit generate"
  },
  "build": {
    "appId": "com.willkrof.sketchspace",
    "productName": "Sketchspace",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/index.html",
      "dist/*.css",
      "dist/app.js",
      "dist/icons/**/*",
      "assets/icon.png",
      "assets/icon.ico"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Sketchspace-mac-universal.${ext}",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "notarize": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Sketchspace-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "will-krof",
        "repo": "sketchspace"
      }
    ]
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
